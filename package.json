{
  "name": "barnabas",
  "private": true,
  "type": "module",
  "description": "Барнабас — Telegram Mini App (index.html) + Firestore rules. Tools here are only for local testing.",
  "scripts": {
    "emulators": "firebase emulators:start --only firestore,auth --project demo-barnabas",
    "serve": "python -m http.server 8766 --bind 127.0.0.1",
    "test:rules": "node tests/rules.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:migrate": "node tests/migrate.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.35.1",
    "puppeteer-core": "^23.11.1"
  }
}
